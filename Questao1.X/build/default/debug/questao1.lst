   348                           ; stack_auto defines a symbol /name/_offset which equates to the
   349                           ; stack offset of the auto object in question
   350     0000                     
   351                           ; stack_param defines a symbol /name/_offset which equates to the
   352                           ; stack offset of the parameter object in question
   353     0000                     
   354                           ; alloc_stack adjusts the SP to allocate space for auto objects
   355                           ; it also links in to the btemp symbol so that can be used
   356     0000                     
   357                           ; restore_stack adjusts the SP to remove all auto and parameter
