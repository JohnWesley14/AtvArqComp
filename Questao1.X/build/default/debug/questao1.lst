   409     03D8                     start_initialization:
   410     03D8                     _main:
   411     03D8  23E1               	call	_portas_settings
   412     03D9  3081               	movlw	129	; move o var para port
   413     03DA  00AE               	movwf	46
   414     03DB  3072               	movlw	114	; move o var para port
   415     03DC  00AC               	movwf	44
   416     03DD  3000               	movlw	0	; move o var para port
   417     03DE  008C               	movwf	contador_4hz
   418     03DF  23F3               	call	_interrupt_settings
   419     03E0  2BEA               	goto	_verify_portA
   420     03E1                     _portas_settings:
   421     03E1  1283               	banksel	5	; bsf STATUS, 5
   422     03E2  0185               	clrf	5
   423     03E3  0186               	clrf	6
   424     03E4  1683               	banksel	133	; bcf STATUS, 5
   425     03E5  0185               	clrf	133	; PORTA é output por padrao
   426     03E6  1485               	bsf	133,1	; ((PORTA) and 07Fh), 1 é input
   427     03E7  0186               	clrf	134	; PORTB inteira é output
   428     03E8  1283               	banksel	5
   429     03E9  3400               	retlw	0
   430     03EA                     _verify_portA:
   431     03EA  1283               	banksel	5
   432     03EB  1C85               	btfss	5,1	; Se o bit ((PORTA) and 07Fh), 1 == 1 pula a próxima instrucao
   433     03EC  2BF0               	goto	_else_if1
   434     03ED                     _if1_PA1_HIGH:
   435                           
   436                           ; Se o ((PORTA) and 07Fh), 1 == 1
   437     03ED  082C               	movf	44,w	; move o var (tratado como reg) para reg
   438     03EE  0086               	movwf	6
   439     03EF  2BF2               	goto	_end
   440     03F0                     _else_if1:
   441                           
   442                           ; Se o ((PORTA) and 07Fh), 1 == 0
   443     03F0  082E               	movf	46,w	; move o var (tratado como reg) para reg
