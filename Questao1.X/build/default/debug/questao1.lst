   365                           	psect	static_vars
   366     000C                     contador_4hz:	
   367                           ; OBS: Todos os botoes/inputs da porta A são pull-up
   368                           
   369     000C                     	ds	1
   370     000D                     divisor_tempo:
   371     000D                     	ds	1
   372     000E                     STATUS_TEMP:
   373     000E                     	ds	1
   374     000F                     W_TEMP:
   375     000F                     	ds	1
   376                           
   377                           	psect	intCode
   378     0004                     	org	4
   379     0004                     _interruptVector:
   380                           
   381                           ; ((INTCON) and 07Fh), 7 = 0 -> impede novas interrupts
   382     0004  008F               	movwf	W_TEMP
   383     0005  0E03               	swapf	3,w
   384     0006  008E               	movwf	STATUS_TEMP
   385     0007  1283               	banksel	11
   386     0008  1D0B               	btfss	11,2	; ((INTCON) and 07Fh), 2: TMR0 que interrompeu
   387     0009  2BF5               	goto	_sair_int
   388     000A                     _recarregaTMR0:	
   389                           ; Recarrega o TMR0 com 250 (256 - 6)
   390                           
   391     000A  110B               	bcf	11,2
   392     000B  1283               	banksel	1
   393     000C  3006               	movlw	6	; move o var para port
   394     000D  0081               	movwf	1
   395                           
   396                           ; Decrementa contador_4hz (O "Prescaler" de software)
   397     000E  0B8C               	decfsz	contador_4hz,f
   398     000F  2BF5               	goto	_sair_int	; Se não chegou a 0, sai e espera o próximo estouro (de 2ms)
   399     0010                     _ifint_ok:
   400                           
   401                           ; 2 Hz
   402     0010  1283               	banksel	5
   403     0011  3001               	movlw	1
   404     0012  0685               	xorwf	5,f	; altera só esse PA0
   405     0013  307D               	movlw	125	; move o var para port
   406     0014  008C               	movwf	contador_4hz
   407     0015                     _if_time_flag_up:
   408     0015  1283               	banksel	divisor_tempo
   409     0016  0B8D               	decfsz	divisor_tempo,f
   410     0017  2BF5               	goto	_sair_int	; Se o múltiplo ainda não zerou, sai
   411     0018  3008               	movlw	8	; move o var para port
   412     0019  008D               	movwf	divisor_tempo
   413     001A  3001               	movlw	1	; move o var para port
   414     001B  0090               	movwf	_time_flag
   415     001C  0E0E               	swapf	STATUS_TEMP,w
   416     001D  0083               	movwf	3
   417     001E  0E8F               	swapf	W_TEMP,f
   418     001F  0E0F               	swapf	W_TEMP,w
   419     0020  0009               	retfie	; return e ((INTCON) and 07Fh), 7 = 1 (habilita de novo)
