   422     03D6                     _portas_settings:	
   423                           ;start_initialization:
   424                           ;_main:
   425                           ; call _portas_settings
   426                           ; movlf 0x81, varALow
   427                           ; movlf 0x72, varAHigh
   428                           ; call _interrupt_settings_S
   429                           ; goto _verificar_sensor_S
   430                           
   431     03D6  1283               	banksel	5	; bsf STATUS, 5
   432     03D7  0185               	clrf	5
   433     03D8  0186               	clrf	6
   434     03D9  1683               	banksel	133	; bcf STATUS, 5
   435     03DA  0185               	clrf	133	; PORTA é output por padrao
   436     03DB  1485               	bsf	133,1	; ((PORTA) and 07Fh), 1 é input
   437     03DC  0186               	clrf	134	; PORTB inteira é output
   438     03DD  1283               	banksel	5
   439     03DE  23E0               	call	_setar_variaveis
   440     03DF  3400               	retlw	0
   441     03E0                     _setar_variaveis:
   442     03E0  307D               	movlw	125	; move o var para port
   443     03E1  008C               	movwf	contador_4hz
   444     03E2  3008               	movlw	8	; move o var para port
   445     03E3  008D               	movwf	divisor_tempo
