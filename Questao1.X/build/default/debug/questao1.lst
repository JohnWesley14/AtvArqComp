   372                           	psect	intCode
   373     0004                     	org	4
   374     0004                     _interruptVector:
   375                           
   376                           ; ((INTCON) and 07Fh), 7 = 0 -> impede novas interrupts
   377     0004  008E               	movwf	W_TEMP
   378     0005  0E03               	swapf	3,w
   379     0006  008D               	movwf	STATUS_TEMP
   380     0007  1283               	banksel	11
   381     0008  1D0B               	btfss	11,2	; ((INTCON) and 07Fh), 2: TMR0 que interrompeu
   382     0009  2BFA               	goto	_sair_int
   383     000A                     _recarregaTMR0:	
   384                           ; Recarrega o TMR0 com 250 (256 - 6)
   385                           
   386     000A  110B               	bcf	11,2
   387     000B  1283               	banksel	1
   388     000C  3006               	movlw	6	; move o var para port
   389     000D  0081               	movwf	1
   390                           
   391                           ; Decrementa contador_4hz (O "Prescaler" de software)
   392     000E  0B8C               	decfsz	contador_4hz,f
   393     000F  2BFA               	goto	_sair_int	; Se não chegou a 0, sai e espera o próximo estouro (de 2ms)
   394     0010                     _ifint_ok:
   395                           
   396                           ; 2 Hz
   397     0010  1283               	banksel	5
   398     0011  3001               	movlw	1
   399     0012  0685               	xorwf	5,f	; altera só esse PA0
   400     0013  303E               	movlw	62	; move o var para port
   401     0014  008C               	movwf	contador_4hz
   402     0015  0E0D               	swapf	STATUS_TEMP,w
   403     0016  0083               	movwf	3
   404     0017  0E8E               	swapf	W_TEMP,f
   405     0018  0E0E               	swapf	W_TEMP,w
   406     0019  0009               	retfie	; return e ((INTCON) and 07Fh), 7 = 1 (habilita de novo)
   407                           
