   368     000C                     STATUS_TEMP:	
   369                           ; OBS: Todos os botoes/inputs da porta A s�o pull-up
   370                           
   371     000C                     	ds	1
   372     000D                     W_TEMP:
   373     000D                     	ds	1
   374     000E                     contador_4hz:
   375     000E                     	ds	1
   376                           
   377                           	psect	intCode
   378     0004                     	org	4
   379     0004                     _interruptVector:
   380                           
   381                           ; ((INTCON) and 07Fh), 7 = 0 -> impede novas interrupts
   382     0004  008D               	movwf	W_TEMP
   383     0005  0E03               	swapf	3,w
   384     0006  008C               	movwf	STATUS_TEMP
   385     0007  1283               	banksel	11
   386     0008  1D0B               	btfss	11,2	; ((INTCON) and 07Fh), 2: TMR0 que interrompeu
   387     0009  2BF7               	goto	_sair_int
   388     000A                     _recarregaTMR0:	
   389                           ; Recarrega o TMR0 com 250 (256 - 6)
   390                           
   391     000A  110B               	bcf	11,2
   392     000B  1283               	banksel	1
   393     000C  3006               	movlw	6	; move o var para port
   394     000D  0081               	movwf	1
   395                           
   396                           ; Decrementa contador_4hz (O "Prescaler" de software)
   397     000E  0B8E               	decfsz	contador_4hz,f
   398     000F  2BF7               	goto	_sair_int	; Se n?o chegou a 0, sai e espera o pr?ximo estouro (de 2ms)
   399     0010                     _ifint_ok:
   400                           
   401                           ; 4 Hz
   402     0010  1283               	banksel	5
   403     0011  3001               	movlw	1	; move o var para port
   404     0012  0685               	xorwf	5,f
   405     0013  307D               	movlw	125	; move o var para port
   406     0014  008E               	movwf	contador_4hz
   407     0015  0E0C               	swapf	STATUS_TEMP,w
   408     0016  0083               	movwf	3
   409     0017  0E8D               	swapf	W_TEMP,f
   410     0018  0E0D               	swapf	W_TEMP,w
   411     0019  0009               	retfie	; return e ((INTCON) and 07Fh), 7 = 1 (habilita de novo)
