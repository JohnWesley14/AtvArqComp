   430     03E2  3081               	movlw	129	; move o var para port
   431     03E3  00AE               	movwf	46
   432     03E4  3072               	movlw	114	; move o var para port
   433     03E5  00AC               	movwf	44
   434     03E6  3400               	retlw	0
   435     03E7                     _verificar_sensor_asm:
   436     03E7  1283               	banksel	5
   437     03E8  1C85               	btfss	5,1	; Se o bit ((PORTA) and 07Fh), 1 == 1 pula a pr�xima instrucao
   438     03E9  2BED               	goto	_else_if1
   439     03EA                     _if1_PA1_HIGH:
   440                           
   441                           ; Se o ((PORTA) and 07Fh), 1 == 1
   442     03EA  082C               	movf	44,w	; move o var (tratado como reg) para reg
