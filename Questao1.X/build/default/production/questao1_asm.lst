   424     03DC  0185               	clrf	133	; PORTA � output por padrao
   425     03DD  1485               	bsf	133,1	; ((PORTA) and 07Fh), 1 � input
   426     03DE  0186               	clrf	134	; PORTB inteira � output
   427     03DF  1283               	banksel	5
   428     03E0  307D               	movlw	125	; move o var para port
