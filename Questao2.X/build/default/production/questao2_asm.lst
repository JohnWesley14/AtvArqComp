   778                           	psect	edata
   779     0000                     stk_offset      set	0
   780     0000                     auto_size       set	0
   781                           
   782                           ; stack_auto defines a symbol /name/_offset which equates to the
   783                           ; stack offset of the auto object in question
   784     0000                     
   785                           ; stack_param defines a symbol /name/_offset which equates to the
   786                           ; stack offset of the parameter object in question
   787     0000                     
   788                           ; alloc_stack adjusts the SP to allocate space for auto objects
   789                           ; it also links in to the btemp symbol so that can be used
   790     0000                     
   791                           ; restore_stack adjusts the SP to remove all auto and parameter
   792                           ; objects from the stack prior to returning from a function
   793     0000                     
   794                           ;#define MY_INTERRUPT_C ; ativar no .s e no .c ou no properties
   795                           ;global _main, start_initialization ; Nao utilizar
   796     0000                     
   797                           	psect	static_vars
   798     0020                     STATUS_TEMP:
   799     0020                     	ds	1
   800     0021                     W_TEMP:
   801     0021                     	ds	1
   802     0022                     _contador_4hz:
   803     0022                     	ds	1
   804     0023                     _divisor_tempo:
   805     0023                     	ds	1
   806                           
   807                           	psect	intCode
   808     0004                     	org	4
   809     0004                     _interruptVector:
   810                           
   811                           ; ((INTCON) and 07Fh), 7 = 0 -> impede novas interrupts
   812     0004  00A1               	movwf	W_TEMP
   813     0005  0E03               	swapf	3,w
   814     0006  00A0               	movwf	STATUS_TEMP
   815     0007  1303 1283          	banksel	11
   816     0009  1D0B               	btfss	11,2	; ((INTCON) and 07Fh), 2: TMR0 que interrompeu
   817     000A  2F68               	goto	_sair_int
   818     000B                     _recarregaTMR0:	
   819                           ; Recarrega o TMR0 com 250 (256 - 6)
   820                           
   821     000B  110B               	bcf	11,2
   822     000C  1303 1283          	banksel	1
   823     000E  3006               	movlw	6	; move o var para port
   824     000F  0081               	movwf	1
   825                           
   826                           ; Decrementa contador_4hz (O "Prescaler" de software)
   827     0010  0BA2               	decfsz	_contador_4hz,f
   828     0011  2F68               	goto	_sair_int	; Se não chegou a 0, sai e espera o próximo estouro (de 2ms)
   829     0012                     _ifint_ok:
   830                           
   831                           ; 4 Hz
   832     0012  1303 1283          	banksel	5
   833     0014  307D               	movlw	125	; move o var para port
   834     0015  00A2               	movwf	_contador_4hz
   835     0016                     _if_time_flag_up:
   836     0016  1303  1283         	banksel	_divisor_tempo
   837     0018  0BA3               	decfsz	_divisor_tempo,f
   838     0019  2F68               	goto	_sair_int	; Se o múltiplo ainda não zerou, sai
   839     001A  3001               	movlw	1	; move o var para port
   840     001B  00A3               	movwf	_divisor_tempo
   841     001C  3001               	movlw	1	; move o var para port
   842     001D  00F3               	movwf	_time_flag
   843     001E  0E20               	swapf	STATUS_TEMP,w
   844     001F  0083               	movwf	3
   845     0020  0EA1               	swapf	W_TEMP,f
   846     0021  0E21               	swapf	W_TEMP,w
   847     0022  0009               	retfie	; return e ((INTCON) and 07Fh), 7 = 1 (habilita de novo)
   848                           
   849                           	psect	verificacao_portas
   850     071A                     _portas_settings_asm:	
   851                           ; start_initialization: ; Usar direto no .c
   852                           ; _main:
   853                           ; call _portas_settings_asm
   854                           ; call _interrupt_settings_asm
   855                           ; goto _verificar_niveis_asm
   856                           
   857     071A  1303 1283          	banksel	5	; bsf STATUS, 5
   858     071C  0185               	clrf	5
   859     071D  0186               	clrf	6
   860     071E  1303 1683          	banksel	133	; bcf STATUS, 5
   861     0720  301E               	movlw	30	; move o var para port
