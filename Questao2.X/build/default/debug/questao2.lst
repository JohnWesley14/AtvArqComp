   349                           ; stack_auto defines a symbol /name/_offset which equates to the
   350                           ; stack offset of the auto object in question
   351     0000                     
   352                           ; stack_param defines a symbol /name/_offset which equates to the
   353                           ; stack offset of the parameter object in question
   354     0000                     
   355                           ; alloc_stack adjusts the SP to allocate space for auto objects
   356                           ; it also links in to the btemp symbol so that can be used
   357     0000                     
   358                           ; restore_stack adjusts the SP to remove all auto and parameter
   359                           ; objects from the stack prior to returning from a function
   360     0000                     
   361                           ; ((PORTA) and 07Fh), 1 = Botao I, ((PORTA) and 07Fh), 2 = A, ((PORTA) and 07Fh), 3 = B, ((PORTA) an
      +                          d 07Fh), 4 = C
   362                           ; ((PORTB) and 07Fh), 0 = Evs, ((PORTB) and 07Fh), 1 = Eve, ((PORTB) and 07Fh), 2 = Status Flag de E
      +                          rro
   363                           ; Flag de Erro:
   364                           ; A e B ativados, mas C desativado; ou A ativado e B e C desativados
   365                           ; ou B ativado e C desativado (PORTA = 0b011I ou 0b110I ou 0b00AI)
   366                           ; I é o botao q pode ser 0 ou 1 e A tbm
   367                           ; OBS: Todos os botoes/inputs da porta A são pull-up
