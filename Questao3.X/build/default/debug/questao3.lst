   370                           	psect	intCode
   371                           
   372                           ;time_flag: ds 1
   373     0004                     	org	4
   374     0004                     _interruptVector:
   375                           
   376                           ; ((INTCON) and 07Fh), 7 = 0 -> impede novas interrupts
   377     0004  008D               	movwf	W_TEMP
   378     0005  0E03               	swapf	3,w
   379     0006  008C               	movwf	STATUS_TEMP
   380     0007  1283               	banksel	11
   381     0008  1D0B               	btfss	11,2	; ((INTCON) and 07Fh), 2: TMR0 que interrompeu
   382     0009  2BF5               	goto	_sair_int
   383     000A                     _recarregaTMR0:	
   384                           ; Recarrega o TMR0 com 250 (256 - 6)
   385                           
   386     000A  110B               	bcf	11,2
   387     000B  1283               	banksel	1
   388     000C  3006               	movlw	6	; move o lit para port
   389     000D  0081               	movwf	1
   390                           
   391                           ; Decrementa contador_4hz (O "Prescaler" de software)
   392     000E  0B8E               	decfsz	contador_4hz,f
   393     000F  2BF5               	goto	_sair_int	; Se não chegou a 0, sai e espera o próximo estouro (de 2ms)
   394     0010                     _ifint_ok:
   395                           
   396                           ; 2 Hz
   397     0010  1283               	banksel	5
   398     0011  3001               	movlw	1
   399     0012  0685               	xorwf	5,f	; altera só esse PA0
   400     0013  307D               	movlw	125	; move o lit para port
   401     0014  008E               	movwf	contador_4hz
   402     0015                     _if_time_flag_up:
   403     0015  1283               	banksel	divisor_tempo
   404     0016  0B8F               	decfsz	divisor_tempo,f
   405     0017  2BF5               	goto	_sair_int	; Se o múltiplo ainda não zerou, sai
   406     0018  3008               	movlw	8	; move o lit para port
   407     0019  008F               	movwf	divisor_tempo
   408     001A  3001               	movlw	1	; move o lit para port
   409     001B  0090               	movwf	_time_flag
   410     001C  0E0C               	swapf	STATUS_TEMP,w
   411     001D  0083               	movwf	3
   412     001E  0E8D               	swapf	W_TEMP,f
   413     001F  0E0D               	swapf	W_TEMP,w
   414     0020  0009               	retfie	; return e ((INTCON) and 07Fh), 7 = 1 (habilita de novo)
