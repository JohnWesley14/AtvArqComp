   358     000C                     STATUS_TEMP:	
   359                           ;global _main, start_initialization
   360                           ; OBS: Todos os botoes/inputs da porta A são pull-up
   361                           
   362     000C                     	ds	1
   363     000D                     W_TEMP:
   364     000D                     	ds	1
   365     000E                     contador_4hz:
   366     000E                     	ds	1
   367     000F                     divisor_tempo:
