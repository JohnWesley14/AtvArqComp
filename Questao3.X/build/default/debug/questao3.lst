   424     03D5  0185               	clrf	5
   425     03D6  0186               	clrf	6
   426     03D7  1683               	banksel	133	; bcf STATUS, 5
   427     03D8  301E               	movlw	30	; move o lit para port
   428     03D9  0085               	movwf	133
   429     03DA  0186               	clrf	134	; PORTB inteira é output por padrao
